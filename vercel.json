{
  "rewrites": [
    { "source": "/e/:id", "destination": "/api/share?id=:id" }
  ],
  "crons": [
    { "path": "/api/reminders", "schedule": "0 7 * * *" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
