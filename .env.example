# Αντιγράψτε αυτό το αρχείο ως .env.local και συμπληρώστε τα. Μετά ξανατρέξτε `npm start`.
# Τις ΙΔΙΕΣ μεταβλητές βάλτε και στο Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API (δημόσια — ασφαλή στον browser)
REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=το-anon-ή-publishable-key

# Ειδοποιήσεις: δημιουργία με  npx web-push generate-vapid-keys
REACT_APP_VAPID_PUBLIC_KEY=δημόσιο-κλειδί

# ---- ΜΥΣΤΙΚΑ: μόνο στο Vercel (server). ΠΟΤΕ με πρόθεμα REACT_APP_ ----
VAPID_PRIVATE_KEY=ιδιωτικό-κλειδί
VAPID_SUBJECT=https://gortynia-demo.vercel.app
SUPABASE_SERVICE_ROLE_KEY=service-role-ή-secret-key
CRON_SECRET=τυχαίο-μακρύ-κείμενο
